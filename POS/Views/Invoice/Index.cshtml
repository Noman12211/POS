@model IEnumerable<POS.Models.Invoice>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Invoice History";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2>Invoice History</h2>

        <p class="text-muted mb-0">
            View all customer invoices
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-plus-circle"></i>
        New Invoice

    </a>

</div>


<div class="card shadow-sm border-0">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>
                            #
                        </th>

                        <th>
                            Invoice Number
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Items
                        </th>

                        <th>
                            Grand Total
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center py-5 text-muted">

                                <i class="bi bi-receipt fs-2 d-block mb-2"></i>

                                No invoices found.

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var invoice in Model)
                        {
                            <tr>

                                <td>
                                    @invoice.Id
                                </td>

                                <td>

                                    <strong>
                                        @invoice.InvoiceNumber
                                    </strong>

                                </td>

                                <td>
                                    @invoice.InvoiceDate.ToString("dd MMM yyyy hh:mm tt")
                                </td>

                                <td>
                                    @invoice.InvoiceItems.Count
                                </td>

                                <td>

                                    <strong>
                                        @invoice.GrandTotal.ToString("N2")
                                    </strong>

                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@invoice.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>
                                        View

                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>