```cshtml
@model POS.POSViewModels.InvoiceCreateViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "New Invoice";

    var foodItems = ViewBag.FoodItems as List<POS.Models.FoodItem>
                     ?? new List<POS.Models.FoodItem>();
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2>New Invoice</h2>
        <p class="text-muted mb-0">
            Create a new customer invoice
        </p>
    </div>

</div>


<div class="row g-4">

    <!-- LEFT SIDE -->
    <div class="col-lg-5">

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <h5 class="mb-4">
                    Add Product
                </h5>


                <!-- Food Item -->
                <div class="mb-3">

                    <label class="form-label">
                        Food Item
                    </label>

                    <select id="foodItem"
                            class="form-select">

                        <option value="">
                            -- Select Food Item --
                        </option>

                        @foreach (var item in foodItems)
                        {
                            <option value="@item.Id">
                                @item.Name
                            </option>
                        }

                    </select>

                </div>


                <!-- Variant -->
                <div class="mb-3">

                    <label class="form-label">
                        Size / Quantity
                    </label>

                    <select id="foodItemVariant"
                            class="form-select"
                            disabled>

                        <option value="">
                            -- Select Size / Quantity --
                        </option>

                    </select>

                </div>


                <!-- Custom Price -->
                <div class="mb-3"
                     id="customPriceContainer"
                     style="display:none;">

                    <label class="form-label">
                        Custom Price
                    </label>

                    <input type="number"
                           id="customPrice"
                           class="form-control"
                           min="0.01"
                           step="0.01"
                           placeholder="Enter amount" />

                </div>


                <!-- Normal Price -->
                <div class="mb-3"
                     id="priceContainer"
                     style="display:none;">

                    <label class="form-label">
                        Price
                    </label>

                    <input type="text"
                           id="variantPrice"
                           class="form-control"
                           readonly />

                </div>


                <!-- Quantity -->
                <div class="mb-4">

                    <label class="form-label">
                        Quantity
                    </label>

                    <input type="number"
                           id="quantity"
                           class="form-control"
                           value="1"
                           min="1"
                           max="1000" />

                </div>


                <button type="button"
                        id="addItemBtn"
                        class="btn btn-primary w-100">

                    <i class="bi bi-plus-circle"></i>
                    Add Item

                </button>

            </div>

        </div>

    </div>


    <!-- RIGHT SIDE -->
    <div class="col-lg-7">

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <h5 class="mb-4">
                    Invoice Items
                </h5>


                <div class="table-responsive">

                    <table class="table align-middle"
                           id="invoiceTable">

                        <thead>

                            <tr>

                                <th>
                                    Item
                                </th>

                                <th>
                                    Variant
                                </th>

                                <th style="width:100px;">
                                    Qty
                                </th>

                                <th>
                                    Price
                                </th>

                                <th>
                                    Total
                                </th>

                                <th style="width:50px;">
                                </th>

                            </tr>

                        </thead>

                        <tbody id="invoiceItems">
                        </tbody>

                    </table>

                </div>


                <!-- Empty message -->
                <div id="emptyMessage"
                     class="text-center text-muted py-4">

                    No items added yet.

                </div>


                <!-- Total -->
                <div class="border-top pt-3 mt-3">

                    <div class="d-flex justify-content-between">

                        <strong>
                            Grand Total
                        </strong>

                        <strong id="grandTotal">
                            0.00
                        </strong>

                    </div>

                </div>


                <!-- Save & Print -->
                <button type="button"
                        id="saveInvoiceBtn"
                        class="btn btn-success w-100 mt-4">

                    <i class="bi bi-check-circle"></i>
                    Save & Print

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        // All food items and their variants
        const foodItems = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
        foodItems.Select(x => new
        {
            id = x.Id,
            name = x.Name,
            variants = x.Variants
        .Where(v => v.IsActive)
        .Select(v => new
        {
            id = v.Id,
            name = v.VariantName,
            price = v.Price,
            isCustomPrice = v.IsCustomPrice
        })
        .ToList()
        })
        )
        );


        // Items currently added to invoice
        let invoiceItems = [];


        // --------------------------------------------------
        // Food Item Change
        // --------------------------------------------------

        document.getElementById("foodItem")
            .addEventListener("change", function () {

                const foodItemId = parseInt(this.value);

                const variantSelect =
                    document.getElementById("foodItemVariant");

                const priceContainer =
                    document.getElementById("priceContainer");

                const customPriceContainer =
                    document.getElementById("customPriceContainer");

                const priceInput =
                    document.getElementById("variantPrice");

                const customPriceInput =
                    document.getElementById("customPrice");


                // Reset
                variantSelect.innerHTML = `
                            <option value="">
                                -- Select Size / Quantity --
                            </option>
                        `;

                variantSelect.disabled = true;

                priceContainer.style.display = "none";
                customPriceContainer.style.display = "none";

                priceInput.value = "";
                customPriceInput.value = "";


                if (!foodItemId) {
                    return;
                }


                // Find selected food item
                const foodItem = foodItems.find(
                    x => x.id === foodItemId
                );


                if (!foodItem) {
                    return;
                }


                // Add variants
                foodItem.variants.forEach(function (variant) {

                    const option =
                        document.createElement("option");

                    option.value = variant.id;

                    option.textContent =
                        variant.name +
                        (variant.isCustomPrice
                            ? ""
                            : " - " +
                            Number(variant.price).toFixed(2));

                    option.dataset.price =
                        variant.price;

                    option.dataset.custom =
                        variant.isCustomPrice;

                    variantSelect.appendChild(option);

                });


                if (foodItem.variants.length > 0) {

                    variantSelect.disabled = false;

                }

            });


        // --------------------------------------------------
        // Variant Change
        // --------------------------------------------------

        document.getElementById("foodItemVariant")
            .addEventListener("change", function () {

                const selectedOption =
                    this.options[this.selectedIndex];

                const priceContainer =
                    document.getElementById("priceContainer");

                const customPriceContainer =
                    document.getElementById("customPriceContainer");

                const priceInput =
                    document.getElementById("variantPrice");

                const customPriceInput =
                    document.getElementById("customPrice");


                priceContainer.style.display = "none";
                customPriceContainer.style.display = "none";

                priceInput.value = "";
                customPriceInput.value = "";


                if (!this.value) {
                    return;
                }


                const isCustom =
                    selectedOption.dataset.custom === "true";


                const price =
                    parseFloat(selectedOption.dataset.price);


                if (isCustom) {

                    // Custom price
                    customPriceContainer.style.display =
                        "block";

                    customPriceInput.focus();

                }
                else {

                    // Normal price
                    priceContainer.style.display =
                        "block";

                    priceInput.value =
                        price.toFixed(2);

                }

            });


        // --------------------------------------------------
        // Add Item
        // --------------------------------------------------

        document.getElementById("addItemBtn")
            .addEventListener("click", function () {

                const foodItemSelect =
                    document.getElementById("foodItem");

                const variantSelect =
                    document.getElementById("foodItemVariant");

                const quantityInput =
                    document.getElementById("quantity");

                const customPriceInput =
                    document.getElementById("customPrice");


                const foodItemId =
                    parseInt(foodItemSelect.value);

                const variantId =
                    parseInt(variantSelect.value);

                const quantity =
                    parseInt(quantityInput.value);


                // Validate food item
                if (!foodItemId) {

                    alert("Please select a food item.");

                    foodItemSelect.focus();

                    return;
                }


                // Validate variant
                if (!variantId) {

                    alert("Please select a size / quantity.");

                    variantSelect.focus();

                    return;
                }


                // Validate quantity
                if (!quantity || quantity < 1) {

                    alert("Please enter a valid quantity.");

                    quantityInput.focus();

                    return;
                }


                // Find food item
                const foodItem =
                    foodItems.find(
                        x => x.id === foodItemId
                    );


                if (!foodItem) {

                    alert("Food item not found.");

                    return;
                }


                // Find variant
                const variant =
                    foodItem.variants.find(
                        x => x.id === variantId
                    );


                if (!variant) {

                    alert("Food item variant not found.");

                    return;
                }


                let price;


                // Custom price
                if (variant.isCustomPrice) {

                    price =
                        parseFloat(customPriceInput.value);


                    if (!price || price <= 0) {

                        alert(
                            "Please enter a valid custom price."
                        );

                        customPriceInput.focus();

                        return;
                    }

                }
                else {

                    price =
                        parseFloat(variant.price);

                }


                // Check whether the same food item + variant
                // already exists
                const existingItem =
                    invoiceItems.find(x =>
                        x.foodItemId === foodItemId &&
                        x.foodItemVariantId === variantId &&
                        (
                            !variant.isCustomPrice ||
                            x.customPrice === price
                        )
                    );


                if (existingItem) {

                    existingItem.quantity += quantity;

                }
                else {

                    invoiceItems.push({

                        foodItemId:
                            foodItemId,

                        foodItemVariantId:
                            variantId,

                        name:
                            foodItem.name,

                        variantName:
                            variant.name,

                        price:
                            price,

                        quantity:
                            quantity,

                        customPrice:
                            variant.isCustomPrice
                                ? price
                                : null

                    });

                }


                renderInvoice();


                // Reset selection
                foodItemSelect.value = "";

                variantSelect.innerHTML = `
                            <option value="">
                                -- Select Size / Quantity --
                            </option>
                        `;

                variantSelect.disabled = true;

                document.getElementById("priceContainer")
                    .style.display = "none";

                document.getElementById("customPriceContainer")
                    .style.display = "none";

                document.getElementById("variantPrice")
                    .value = "";

                document.getElementById("customPrice")
                    .value = "";

                quantityInput.value = 1;

            });


        // --------------------------------------------------
        // Render Invoice
        // --------------------------------------------------

        function renderInvoice() {

            const tbody =
                document.getElementById("invoiceItems");

            tbody.innerHTML = "";


            let grandTotal = 0;


            if (invoiceItems.length === 0) {

                document.getElementById("emptyMessage")
                    .style.display = "block";

            }
            else {

                document.getElementById("emptyMessage")
                    .style.display = "none";

            }


            invoiceItems.forEach(function (item, index) {

                const total =
                    item.price * item.quantity;


                grandTotal += total;


                const row =
                    document.createElement("tr");


                row.innerHTML = `

                            <td>
                                <strong>
                                    ${escapeHtml(item.name)}
                                </strong>
                            </td>

                            <td>
                                ${escapeHtml(item.variantName)}
                            </td>

                            <td>

                                <input type="number"
                                       class="form-control form-control-sm item-quantity"
                                       value="${item.quantity}"
                                       min="1"
                                       max="1000"
                                       data-index="${index}">

                            </td>

                            <td>
                                ${item.price.toFixed(2)}
                            </td>

                            <td>
                                <strong>
                                    ${total.toFixed(2)}
                                </strong>
                            </td>

                            <td>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger remove-item"
                                        data-index="${index}">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </td>

                        `;


                tbody.appendChild(row);

            });


            document.getElementById("grandTotal")
                .textContent =
                grandTotal.toFixed(2);


            // --------------------------------------------------
            // Quantity Change
            // --------------------------------------------------

            document.querySelectorAll(".item-quantity")
                .forEach(function (input) {

                    input.addEventListener(
                        "change",
                        function () {

                            const index =
                                parseInt(this.dataset.index);

                            let quantity =
                                parseInt(this.value);


                            if (!quantity || quantity < 1) {

                                quantity = 1;

                                this.value = 1;

                            }


                            if (quantity > 1000) {

                                quantity = 1000;

                                this.value = 1000;

                            }


                            invoiceItems[index].quantity =
                                quantity;


                            renderInvoice();

                        }
                    );

                });


            // --------------------------------------------------
            // Remove Item
            // --------------------------------------------------

            document.querySelectorAll(".remove-item")
                .forEach(function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            const index =
                                parseInt(this.dataset.index);


                            invoiceItems.splice(
                                index,
                                1
                            );


                            renderInvoice();

                        }
                    );

                });

        }


        // --------------------------------------------------
        // Save Invoice
        // --------------------------------------------------

        document.getElementById("saveInvoiceBtn")
            .addEventListener("click", async function () {

                if (invoiceItems.length === 0) {

                    alert(
                        "Please add at least one item."
                    );

                    return;
                }


                const button = this;


                // Prevent double clicking
                button.disabled = true;

                button.innerHTML = `
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Saving...
                        `;


                try {

                    const response =
                        await fetch(
                            "@Url.Action("Save", "Invoice")",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body: JSON.stringify({

                                    items:
                                        invoiceItems.map(item => ({

                                            foodItemVariantId:
                                                item.foodItemVariantId,

                                            quantity:
                                                item.quantity,

                                            customPrice:
                                                item.customPrice

                                        }))

                                })

                            }
                        );


                    if (!response.ok) {

                        const errorText =
                            await response.text();

                        throw new Error(
                            errorText ||
                            "Failed to save invoice."
                        );

                    }


                    const result =
                        await response.json();


                    if (result.success) {

                        // For now we simply redirect.
                        // Direct thermal printing will be
                        // added in the next step.

                        window.location.href =
                            "@Url.Action("Details", "Invoice")" +
                            "?id=" +
                            result.invoiceId;

                    }
                    else {

                        throw new Error(
                            "Invoice could not be saved."
                        );

                    }

                }
                catch (error) {

                    console.error(error);

                    alert(
                        error.message ||
                        "Something went wrong while saving the invoice."
                    );


                    button.disabled = false;

                    button.innerHTML = `
                                <i class="bi bi-check-circle"></i>
                                Save & Print
                            `;

                }

            });


        // --------------------------------------------------
        // HTML Escape
        // --------------------------------------------------

        function escapeHtml(value) {

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }


        // Initial render
        renderInvoice();

    </script>

}
```
