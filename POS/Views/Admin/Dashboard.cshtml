@model POS.POSViewModels.DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";

    var today = DateTime.Now;
}

<div class="dash-page">

    <div class="dash-header">
        <div>
            <h2>Dashboard</h2>
            <p>Here's how today is going.</p>
        </div>
        <div class="dash-date">@today.ToString("dddd, d MMMM")</div>
    </div>

    <div class="stat-grid">

        <!-- HERO: TODAY'S SALES -->
        <div class="stat-card stat-card--hero">

            <svg class="card-bg" viewBox="0 0 400 220" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 170 Q 80 120 160 150 T 400 110 V220 H0 Z" fill="rgba(255,255,255,0.08)" />
                <path d="M0 190 Q 100 150 200 175 T 400 150 V220 H0 Z" fill="rgba(255,255,255,0.06)" />
            </svg>

            <div class="card-top">
                <span class="card-label">Today's sales</span>
                <span class="icon-badge">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M3 17l5-5 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M15 6h5v5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
            </div>

            <div class="card-value">Rs @Model.TodaySale.ToString("N0")</div>
            <div class="card-caption">as of @today.ToString("h:mm tt")</div>

        </div>

        <div class="stat-stack">

            <div class="stat-stack-row">

                <!-- PRODUCTS -->
                <div class="stat-card stat-card--products">

                    <svg class="card-bg" viewBox="0 0 200 120" aria-hidden="true">
                        <circle cx="170" cy="20" r="60" fill="rgba(255,255,255,0.10)" />
                        <circle cx="185" cy="40" r="30" fill="rgba(255,255,255,0.08)" />
                    </svg>

                    <div class="card-top">
                        <span class="icon-badge">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5v-7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                <path d="M4 8.5 12 13l8-4.5M12 13v7" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                            </svg>
                        </span>
                    </div>

                    <div class="card-value">@Model.productsCount</div>
                    <div class="card-label">Products in menu</div>

                </div>

                <!-- INVOICES -->
                <div class="stat-card stat-card--invoices">

                    <svg class="card-bg" viewBox="0 0 200 120" aria-hidden="true">
                        <rect x="150" y="-10" width="80" height="80" rx="18" fill="rgba(255,255,255,0.10)" transform="rotate(18 190 30)" />
                    </svg>

                    <div class="card-top">
                        <span class="icon-badge">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M6 3h12v17l-2.5-1.5L13 20l-2.5-1.5L8 20l-2-1.5V3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                <path d="M9 8h6M9 11.5h6M9 15h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            </svg>
                        </span>
                    </div>

                    <div class="card-value">@Model.TodaysInvoice</div>
                    <div class="card-label">Invoices today</div>

                </div>

            </div>

            <!-- DEALS -->
            <div class="stat-card stat-card--deals">

                <svg class="card-bg" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
                    <circle cx="370" cy="10" r="70" fill="rgba(255,255,255,0.10)" />
                    <circle cx="40" cy="110" r="50" fill="rgba(255,255,255,0.06)" />
                </svg>

                <div class="card-top card-top--wide">

                    <span class="icon-badge">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12.6 3.5 20 10.9a2 2 0 0 1 0 2.8l-6.3 6.3a2 2 0 0 1-2.8 0L4.5 12.6V5.5A2 2 0 0 1 6.5 3.5h6.1Z"
                                  stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                            <circle cx="9" cy="8" r="1.4" fill="currentColor" />
                        </svg>
                    </span>

                    <div class="card-top-text">
                        <div class="card-value card-value--inline">@Model.DealsCount</div>
                        <div class="card-label">Active deals</div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .dash-page {
        --ink: #1c1c26;
        --muted: #7a7a85;
        font-family: "Inter", system-ui, sans-serif;
        color: var(--ink);
        padding: clamp(16px, 3vw, 32px);
    }

    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 26px;
    }

        .dash-header h2 {
            font-family: "Space Grotesk", "Inter", sans-serif;
            font-weight: 600;
            font-size: 1.8rem;
            margin: 0 0 4px;
        }

        .dash-header p {
            margin: 0;
            color: var(--muted);
        }

    .dash-date {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--muted);
        background: #fff;
        border: 1px solid #eceae3;
        padding: 7px 14px;
        border-radius: 999px;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
        gap: 22px;
        align-items: stretch;
    }

    .stat-stack {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .stat-stack-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }

    .stat-card {
        position: relative;
        overflow: hidden;
        padding: 26px 26px 22px;
        color: #fff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 130px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .card-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }

    .card-top,
    .card-value,
    .card-label,
    .card-caption {
        position: relative;
        z-index: 1;
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .card-top--wide {
        align-items: center;
        gap: 14px;
    }

    .card-top-text {
        display: flex;
        flex-direction: column;
    }

    .icon-badge {
        flex: none;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .icon-badge svg {
            width: 20px;
            height: 20px;
        }

    .card-value {
        font-family: "Space Grotesk", "Inter", sans-serif;
        font-weight: 600;
        line-height: 1;
    }

    .card-value--inline {
        font-size: 1.6rem;
    }

    .card-label {
        font-size: 0.85rem;
        opacity: 0.9;
        margin-top: 6px;
    }

    .card-top--wide .card-label {
        margin-top: 2px;
    }

    .card-caption {
        font-size: 0.75rem;
        opacity: 0.75;
        margin-top: 4px;
    }

    /* HERO — sales */
    .stat-card--hero {
        border-radius: 28px;
        background: linear-gradient(135deg, #0f766e 0%, #14b8a6 45%, #3b82f6 100%);
        box-shadow: 0 20px 40px -18px rgba(15, 118, 110, 0.55);
        justify-content: flex-end;
        gap: 4px;
    }

        .stat-card--hero .card-top {
            position: absolute;
            top: 26px;
            left: 26px;
            right: 26px;
        }

        .stat-card--hero .card-label {
            font-size: 0.95rem;
            margin: 0;
            opacity: 0.85;
        }

        .stat-card--hero .card-value {
            font-size: 2.6rem;
            margin-top: 34px;
        }

    /* PRODUCTS */
    .stat-card--products {
        border-radius: 20px;
        background: linear-gradient(135deg, #6d28d9 0%, #a855f7 100%);
        box-shadow: 0 16px 32px -16px rgba(109, 40, 217, 0.55);
        min-height: 128px;
    }

        .stat-card--products .card-value {
            font-size: 2rem;
            margin-top: 10px;
        }

    /* INVOICES */
    .stat-card--invoices {
        border-radius: 20px;
        background: linear-gradient(135deg, #ea580c 0%, #f59e0b 100%);
        box-shadow: 0 16px 32px -16px rgba(234, 88, 12, 0.5);
        min-height: 128px;
    }

        .stat-card--invoices .card-value {
            font-size: 2rem;
            margin-top: 10px;
        }

    /* DEALS */
    .stat-card--deals {
        border-radius: 20px;
        background: linear-gradient(135deg, #be123c 0%, #f43f5e 55%, #fb7185 100%);
        box-shadow: 0 16px 32px -16px rgba(190, 18, 60, 0.5);
        min-height: 84px;
        justify-content: center;
    }

    /* Entrance — one orchestrated moment, not per-card hover tricks */
    .stat-card {
        animation: dash-rise 0.5s ease-out both;
    }

    .stat-card--hero {
        animation-delay: 0s;
    }

    .stat-card--products {
        animation-delay: 0.08s;
    }

    .stat-card--invoices {
        animation-delay: 0.14s;
    }

    .stat-card--deals {
        animation-delay: 0.2s;
    }

    @@keyframes dash-rise {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .stat-card {
            animation: none;
        }

            .stat-card:hover {
                transform: none;
            }
    }

    @@media (max-width: 768px) {
        .stat-grid {
            grid-template-columns: 1fr;
        }

        .stat-stack-row {
            grid-template-columns: 1fr;
        }

        .stat-card--hero .card-value {
            font-size: 2.1rem;
        }
    }

</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600&display=swap" rel="stylesheet">