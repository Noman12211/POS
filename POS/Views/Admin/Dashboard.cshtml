@model POS.POSViewModels.DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <h2 class="mb-4">Dashboard</h2>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-muted">
                        Products
                    </h6>

                    <h2>
                        @Model.productsCount
                    </h2>

                </div>
            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-muted">
                        Today's Invoices
                    </h6>

                    <h2>
                        @Model.TodaysInvoice
                    </h2>

                </div>
            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-muted">
                        Today's Sales
                    </h6>

                    <h2>
                        @Model.TodaySale
                    </h2>

                </div>
            </div>

        </div>

    </div>

</div>