@model POS.Models.FoodItem

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Product";
}

<div class="mb-4">

    <h2>Add Product</h2>

    <p class="text-muted">
        Add a new food item to your menu.
    </p>

</div>


<div class="card shadow-sm border-0">

    <div class="card-body">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="mb-3">

                <label asp-for="Name"
                       class="form-label">
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="e.g. Large Pizza" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="Price"
                       class="form-label">
                </label>

                <input asp-for="Price"
                       class="form-control"
                       type="number"
                       step="0.01"
                       placeholder="0.00" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>

            </div>


            <div class="form-check mb-4">

                <input asp-for="IsActive"
                       class="form-check-input" />

                <label asp-for="IsActive"
                       class="form-check-label">
                </label>

            </div>


            <div>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-circle"></i>
                    Save Product

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}