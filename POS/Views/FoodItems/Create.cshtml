@model POS.POSViewModels.FoodItemCreateViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Product";
}

<div class="mb-4">

    <h2>Add Product</h2>

    <p class="text-muted">
        Add a new food item and its variants to your menu.
    </p>

</div>


<form asp-action="Create" method="post"enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>


    <!-- PRODUCT INFORMATION -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Product Information
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- PRODUCT NAME -->
                <div class="col-md-3 mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. Pizza" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- BASE PRICE -->
                <div class="col-md-3 mb-3">

                    <label asp-for="Price"
                           class="form-label">
                    </label>

                    <input asp-for="Price"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="0.00" />

                    <span asp-validation-for="Price"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        Used when the product does not have a variant.
                    </small>

                </div>

                <!-- Image -->
                <div class="col-md-3 mb-3">
                    <label asp-for="ImageFile" class="form-label"></label>

                    <input asp-for="ImageFile"
                           class="form-control"
                           type="file"
                           accept="image/*" />

                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <!-- ACTIVE -->
                <div class="col-md-3 mb-3">
                    <label asp-for="IsActive" class="form-label"></label>
                <div class="form-check">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label> IsActive
                    </label>

                </div>
                </div>

            </div>


            

        </div>

    </div>



    <!-- VARIANTS -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">

            <div>

                <h5 class="mb-0">
                    Product Variants
                </h5>

                <small class="text-muted">
                    Add sizes, types, or other variations.
                </small>

            </div>

            <button type="button"
                    class="btn btn-primary btn-sm"
                    id="addVariantBtn">

                <i class="bi bi-plus-circle"></i>
                Add Variant

            </button>

        </div>


        <div class="card-body">

            <div id="variantsContainer">

                @if (Model.Variants != null && Model.Variants.Any())
                {
                    for (int i = 0; i < Model.Variants.Count; i++)
                    {
                        <div class="variant-row border rounded p-3 mb-3">

                            <div class="row align-items-end">

                                <!-- VARIANT NAME -->
                                <div class="col-md-4 mb-3 mb-md-0">

                                    <label class="form-label">
                                        Variant Name
                                    </label>

                                    <input name="Variants[@i].VariantName"
                                           value="@Model.Variants[i].VariantName"
                                           class="form-control"
                                           placeholder="e.g. Large" />

                                </div>


                                <!-- PRICE -->
                                <div class="col-md-3 mb-3 mb-md-0">

                                    <label class="form-label">
                                        Price
                                    </label>

                                    <input name="Variants[@i].Price"
                                           value="@Model.Variants[i].Price"
                                           class="form-control variant-price"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           placeholder="0.00" />

                                </div>


                                <!-- CUSTOM PRICE -->
                                <div class="col-md-2 mb-3 mb-md-0">

                                    <div class="form-check">

                                        <input type="hidden"
                                               name="Variants[@i].IsCustomPrice"
                                               value="false" />

                                        <input name="Variants[@i].IsCustomPrice"
                                               value="true"
                                               type="checkbox"
                                               class="form-check-input custom-price-checkbox"
                                        @(Model.Variants[i].IsCustomPrice ? "checked" : "") />

                                        <label class="form-check-label">
                                            Custom Price
                                        </label>

                                    </div>

                                </div>


                                <!-- ACTIVE -->
                                <div class="col-md-2 mb-3 mb-md-0">

                                    <div class="form-check">

                                        <input type="hidden"
                                               name="Variants[@i].IsActive"
                                               value="false" />

                                        <input name="Variants[@i].IsActive"
                                               value="true"
                                               type="checkbox"
                                               class="form-check-input"
                                        @(Model.Variants[i].IsActive ? "checked" : "") />

                                        <label class="form-check-label">
                                            Active
                                        </label>

                                    </div>

                                </div>


                                <!-- REMOVE -->
                                <div class="col-md-1 text-end">

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm remove-variant"
                                            title="Remove variant">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>

                            </div>

                        </div>
                    }
                }

            </div>


            <!-- NO VARIANTS MESSAGE -->
            <div id="noVariantsMessage"
                 class="text-center text-muted py-4">

                <i class="bi bi-box-seam fs-2 d-block mb-2"></i>

                No variants added.

                <div>
                    Click <strong>Add Variant</strong> to add one.
                </div>

            </div>

        </div>

    </div>



    <!-- BUTTONS -->
    <div class="mb-4">

        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-check-circle"></i>
            Save Product

        </button>


        <a asp-action="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </div>

</form>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

        ```html
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            let variantIndex = @((Model.Variants?.Count ?? 0));

            const addVariantBtn = document.getElementById("addVariantBtn");
            const variantsContainer = document.getElementById("variantsContainer");
            const noVariantsMessage = document.getElementById("noVariantsMessage");

            // --------------------------------------------------
            // UPDATE "NO VARIANTS" MESSAGE
            // --------------------------------------------------
            function updateNoVariantsMessage() {
                if (!noVariantsMessage) return;

                const rows = variantsContainer.querySelectorAll(".variant-row");

                if (rows.length === 0) {
                    noVariantsMessage.style.display = "block";
                } else {
                    noVariantsMessage.style.display = "none";
                }
            }


            // --------------------------------------------------
            // ADD NEW VARIANT
            // --------------------------------------------------
            if (addVariantBtn) {

                addVariantBtn.addEventListener("click", function (e) {

                    e.preventDefault();

                    const html = `
                            <div class="variant-row border rounded p-3 mb-3">

                                <input type="hidden"
                                       name="Variants[${variantIndex}].Id"
                                       value="0" />

                                <div class="row align-items-end">

                                    <div class="col-md-4">
                                        <label class="form-label">
                                            Variant Name
                                        </label>

                                        <input type="text"
                                               name="Variants[${variantIndex}].VariantName"
                                               class="form-control"
                                               placeholder="e.g. Small, Medium, Large"
                                               required />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">
                                            Price
                                        </label>

                                        <input type="number"
                                               name="Variants[${variantIndex}].Price"
                                               class="form-control variant-price"
                                               value="0"
                                               min="0"
                                               step="0.01" />
                                    </div>

                                    <div class="col-md-2">

                                        <div class="form-check">

                                            <input type="hidden"
                                                   name="Variants[${variantIndex}].IsCustomPrice"
                                                   value="false" />

                                            <input type="checkbox"
                                                   name="Variants[${variantIndex}].IsCustomPrice"
                                                   value="true"
                                                   class="form-check-input custom-price-checkbox" />

                                            <label class="form-check-label">
                                                Custom Price
                                            </label>

                                        </div>

                                    </div>

                                    <div class="col-md-2">

                                        <div class="form-check">

                                            <input type="hidden"
                                                   name="Variants[${variantIndex}].IsActive"
                                                   value="false" />

                                            <input type="checkbox"
                                                   name="Variants[${variantIndex}].IsActive"
                                                   value="true"
                                                   class="form-check-input"
                                                   checked />

                                            <label class="form-check-label">
                                                Active
                                            </label>

                                        </div>

                                    </div>

                                    <div class="col-md-1">

                                        <button type="button"
                                                class="btn btn-danger remove-variant"
                                                title="Remove Variant">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>

                                </div>

                            </div>
                        `;

                    variantsContainer.insertAdjacentHTML("beforeend", html);

                    variantIndex++;

                    updateNoVariantsMessage();
                });
            }


            // --------------------------------------------------
            // CUSTOM PRICE CHECKBOX
            // --------------------------------------------------
            document.addEventListener("change", function (e) {

                if (!e.target.classList.contains("custom-price-checkbox")) {
                    return;
                }

                const row = e.target.closest(".variant-row");

                if (!row) return;

                const priceInput = row.querySelector(".variant-price");

                if (!priceInput) return;

                if (e.target.checked) {

                    priceInput.value = "0";
                    priceInput.disabled = true;

                } else {

                    priceInput.disabled = false;

                }
            });


            // --------------------------------------------------
            // REMOVE VARIANT
            // --------------------------------------------------
            document.addEventListener("click", function (e) {

                const removeButton = e.target.closest(".remove-variant");

                if (!removeButton) {
                    return;
                }

                e.preventDefault();

                const row = removeButton.closest(".variant-row");

                if (row) {
                    row.remove();
                }

                updateNoVariantsMessage();
            });


            // --------------------------------------------------
            // INITIAL STATE
            // --------------------------------------------------
            updateNoVariantsMessage();

        });
    </script>
