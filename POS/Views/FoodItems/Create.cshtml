@model POS.POSViewModels.FoodItemCreateViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Product";
}

<div class="mb-4">

    <h2>Add Product</h2>

    <p class="text-muted">
        Add a new food item and its variants to your menu.
    </p>

</div>


<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>


    <!-- PRODUCT INFORMATION -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Product Information
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- PRODUCT NAME -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. Pizza" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- BASE PRICE -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Price"
                           class="form-label">
                    </label>

                    <input asp-for="Price"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="0.00" />

                    <span asp-validation-for="Price"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        Used when the product does not have a variant.
                    </small>

                </div>

            </div>


            <!-- ACTIVE -->
            <div class="form-check">

                <input asp-for="IsActive"
                       class="form-check-input" />

                <label asp-for="IsActive"
                       class="form-check-label">
                </label>

            </div>

        </div>

    </div>



    <!-- VARIANTS -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">

            <div>

                <h5 class="mb-0">
                    Product Variants
                </h5>

                <small class="text-muted">
                    Add sizes, types, or other variations.
                </small>

            </div>

            <button type="button"
                    class="btn btn-primary btn-sm"
                    id="addVariantBtn">

                <i class="bi bi-plus-circle"></i>
                Add Variant

            </button>

        </div>


        <div class="card-body">

            <div id="variantsContainer">

                @if (Model.Variants != null && Model.Variants.Any())
                {
                    for (int i = 0; i < Model.Variants.Count; i++)
                    {
                        <div class="variant-row border rounded p-3 mb-3">

                            <div class="row align-items-end">

                                <!-- VARIANT NAME -->
                                <div class="col-md-4 mb-3 mb-md-0">

                                    <label class="form-label">
                                        Variant Name
                                    </label>

                                    <input name="Variants[@i].VariantName"
                                           value="@Model.Variants[i].VariantName"
                                           class="form-control"
                                           placeholder="e.g. Large" />

                                </div>


                                <!-- PRICE -->
                                <div class="col-md-3 mb-3 mb-md-0">

                                    <label class="form-label">
                                        Price
                                    </label>

                                    <input name="Variants[@i].Price"
                                           value="@Model.Variants[i].Price"
                                           class="form-control variant-price"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           placeholder="0.00" />

                                </div>


                                <!-- CUSTOM PRICE -->
                                <div class="col-md-2 mb-3 mb-md-0">

                                    <div class="form-check">

                                        <input type="hidden"
                                               name="Variants[@i].IsCustomPrice"
                                               value="false" />

                                        <input name="Variants[@i].IsCustomPrice"
                                               value="true"
                                               type="checkbox"
                                               class="form-check-input custom-price-checkbox"
                                        @(Model.Variants[i].IsCustomPrice ? "checked" : "") />

                                        <label class="form-check-label">
                                            Custom Price
                                        </label>

                                    </div>

                                </div>


                                <!-- ACTIVE -->
                                <div class="col-md-2 mb-3 mb-md-0">

                                    <div class="form-check">

                                        <input type="hidden"
                                               name="Variants[@i].IsActive"
                                               value="false" />

                                        <input name="Variants[@i].IsActive"
                                               value="true"
                                               type="checkbox"
                                               class="form-check-input"
                                        @(Model.Variants[i].IsActive ? "checked" : "") />

                                        <label class="form-check-label">
                                            Active
                                        </label>

                                    </div>

                                </div>


                                <!-- REMOVE -->
                                <div class="col-md-1 text-end">

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm remove-variant"
                                            title="Remove variant">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>

                            </div>

                        </div>
                    }
                }

            </div>


            <!-- NO VARIANTS MESSAGE -->
            <div id="noVariantsMessage"
                 class="text-center text-muted py-4">

                <i class="bi bi-box-seam fs-2 d-block mb-2"></i>

                No variants added.

                <div>
                    Click <strong>Add Variant</strong> to add one.
                </div>

            </div>

        </div>

    </div>



    <!-- BUTTONS -->
    <div class="mb-4">

        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-check-circle"></i>
            Save Product

        </button>


        <a asp-action="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </div>

</form>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        let variantIndex = @((Model.Variants?.Count ?? 0));


        // -----------------------------------------
        // ADD VARIANT
        // -----------------------------------------

        $("#addVariantBtn").on("click", function () {

            const html = `

                <div class="variant-row border rounded p-3 mb-3">

                    <div class="row align-items-end">

                        <!-- VARIANT NAME -->

                        <div class="col-md-4 mb-3 mb-md-0">

                            <label class="form-label">
                                Variant Name
                            </label>

                            <input name="Variants[${variantIndex}].VariantName"
                                   class="form-control"
                                   placeholder="e.g. Large" />

                        </div>


                        <!-- PRICE -->

                        <div class="col-md-3 mb-3 mb-md-0">

                            <label class="form-label">
                                Price
                            </label>

                            <input name="Variants[${variantIndex}].Price"
                                   class="form-control variant-price"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00" />

                        </div>


                        <!-- CUSTOM PRICE -->

                        <div class="col-md-2 mb-3 mb-md-0">

                            <div class="form-check">

                                <input type="hidden"
                                       name="Variants[${variantIndex}].IsCustomPrice"
                                       value="false" />

                                <input name="Variants[${variantIndex}].IsCustomPrice"
                                       value="true"
                                       type="checkbox"
                                       class="form-check-input custom-price-checkbox" />

                                <label class="form-check-label">
                                    Custom Price
                                </label>

                            </div>

                        </div>


                        <!-- ACTIVE -->

                        <div class="col-md-2 mb-3 mb-md-0">

                            <div class="form-check">

                                <input type="hidden"
                                       name="Variants[${variantIndex}].IsActive"
                                       value="false" />

                                <input name="Variants[${variantIndex}].IsActive"
                                       value="true"
                                       type="checkbox"
                                       class="form-check-input"
                                       checked />

                                <label class="form-check-label">
                                    Active
                                </label>

                            </div>

                        </div>


                        <!-- REMOVE -->

                        <div class="col-md-1 text-end">

                            <button type="button"
                                    class="btn btn-outline-danger btn-sm remove-variant"
                                    title="Remove variant">

                                <i class="bi bi-trash"></i>

                            </button>

                        </div>

                    </div>

                </div>
            `;


            $("#variantsContainer").append(html);

            variantIndex++;

            updateNoVariantsMessage();

        });


        // -----------------------------------------
        // REMOVE VARIANT
        // -----------------------------------------

        $(document).on("click", ".remove-variant", function () {

            $(this).closest(".variant-row").remove();

            updateNoVariantsMessage();

        });


        // -----------------------------------------
        // CUSTOM PRICE
        // -----------------------------------------

        $(document).on(
            "change",
            ".custom-price-checkbox",
            function () {

                const row = $(this).closest(".variant-row");

                const priceInput = row.find(".variant-price");

                if ($(this).is(":checked")) {

                    priceInput.val("");

                    priceInput.prop("disabled", true);

                    priceInput.attr(
                        "placeholder",
                        "Price entered at sale"
                    );

                }
                else {

                    priceInput.prop("disabled", false);

                    priceInput.attr(
                        "placeholder",
                        "0.00"
                    );

                }

            }
        );


        // -----------------------------------------
        // NO VARIANTS MESSAGE
        // -----------------------------------------

        function updateNoVariantsMessage() {

            if ($("#variantsContainer .variant-row").length === 0) {

                $("#noVariantsMessage").show();

            }
            else {

                $("#noVariantsMessage").hide();

            }

        }


        $(document).ready(function () {

            updateNoVariantsMessage();

        });

    </script>
}