@model IEnumerable<POS.Models.FoodItem>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2>Products</h2>
        <p class="text-muted mb-0">
            Manage your food items
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-plus-circle"></i>
        Add Product

    </a>

</div>
@if (TempData["SuccessMessage"] != null)
{
    <div id="tempSuccessMsg" data-message="@TempData["SuccessMessage"]"></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div id="tempErrorMsg" data-message="@TempData["ErrorMessage"]"></div>
}

<div class="card shadow-sm border-0">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>
                        <th>#</th>
                        <th>Image</th>
                        <th>Product</th> 
                        <th>Status</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.Id
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath"
                                         alt="@item.Name"
                                         style="width:80px; height:80px; object-fit:cover;" />
                                }
                                else
                                {
                                    <span>No Image</span>
                                }
                            </td>

                            <td>
                                <strong>
                                    @item.Name
                                </strong>
                            </td>

                            

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td class="text-end">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline delete-form">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
<script>
    $(document).ready(function () {
        const successEl = document.getElementById("tempSuccessMsg");
        const errorEl = document.getElementById("tempErrorMsg");

        if (successEl) {
            Swal.fire({
                icon: "success",
                title: "Success",
                text: successEl.dataset.message,
                timer: 2000,
                showConfirmButton: false
            });
        }

        if (errorEl) {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: errorEl.dataset.message
            });
        }
    });
    $(document).on("submit", ".delete-form", function (e) {
        e.preventDefault();

        const form = this;
        const url = form.action;
        const token = $(form).find('input[name="__RequestVerificationToken"]').val();
        const row = $(form).closest("tr");

        Swal.fire({
            title: "Delete this product?",
            text: "This action cannot be undone.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it",
            cancelButtonText: "Cancel",
            confirmButtonColor: "#dc3545"
        }).then((result) => {
            if (!result.isConfirmed) return;

            $.ajax({
                url: url,
                type: "POST",
                data: { __RequestVerificationToken: token },
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: "success",
                            title: "Deleted!",
                            text: response.message,
                            timer: 1500,
                            showConfirmButton: false
                        });
                        row.fadeOut(300, function () {
                            row.remove();
                        });
                    } else {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: response.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "Unable to reach the server. Please try again."
                    });
                }
            });
        });
    });
    </script>