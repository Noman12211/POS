@model IEnumerable<POS.Models.Deal>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Deals";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2>Deals</h2>

        <p class="text-muted mb-0">
            Manage combo deals and bundled offers.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-plus-circle"></i>
        Add Deal

    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="card shadow-sm border-0">

    <div class="card-body">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                Deal
                            </th>

                            <th>
                                Items
                            </th>

                            <th>
                                Price
                            </th>

                            <th>
                                Duration
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var deal in Model)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @deal.Name
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(deal.Description))
                                    {
                                        <div class="text-muted small">
                                            @deal.Description
                                        </div>
                                    }

                                </td>


                                <td>

                                    @if (deal.DealItems != null && deal.DealItems.Any())
                                    {
                                        <ul class="list-unstyled mb-0 small">

                                            @foreach (var item in deal.DealItems)
                                            {
                                                <li>
                                                    @item.Quantity&times;
                                                    @item.FoodItemVariant?.FoodItem?.Name
                                                    @if (!string.IsNullOrWhiteSpace(item.FoodItemVariant?.VariantName))
                                                    {
                                                        <span class="text-muted">
                                                            (@item.FoodItemVariant.VariantName)
                                                        </span>
                                                    }
                                                </li>
                                            }

                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No items
                                        </span>
                                    }

                                </td>


                                <td>

                                    <strong>
                                        @deal.DealPrice.ToString("N2")
                                    </strong>

                                </td>


                                <td>

                                    @if (deal.StartDate.HasValue || deal.EndDate.HasValue)
                                    {
                                        <div class="small">

                                            @if (deal.StartDate.HasValue)
                                            {
                                                <div>
                                                    From @deal.StartDate.Value.ToString("dd MMM yyyy")
                                                </div>
                                            }

                                            @if (deal.EndDate.HasValue)
                                            {
                                                <div>
                                                    Until @deal.EndDate.Value.ToString("dd MMM yyyy")
                                                </div>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No limit
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (deal.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@deal.Id"
                                       class="btn btn-sm btn-outline-secondary">

                                        <i class="bi bi-eye"></i>
                                        View

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@deal.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-pencil"></i>
                                        Edit

                                    </a>

                                    <form asp-action="ToggleActive"
                                          asp-route-id="@deal.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-warning">

                                            @if (deal.IsActive)
                                            {
                                                <i class="bi bi-pause-circle"></i>
                                                <text>Deactivate</text>
                                            }
                                            else
                                            {
                                                <i class="bi bi-play-circle"></i>
                                                <text>Activate</text>
                                            }

                                        </button>

                                    </form>

                                    <form asp-action="Delete"
                                          asp-route-id="@deal.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this deal?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">

                                            <i class="bi bi-trash"></i>
                                            Delete

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-tags fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No deals found
                </h5>

                <p class="text-muted">
                    Start by creating a deal to bundle your products together.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle"></i>
                    Add Deal

                </a>

            </div>
        }

    </div>

</div>