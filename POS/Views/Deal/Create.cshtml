@model POS.POSViewModels.DealFormViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Deal";

    var variants = ViewBag.FoodItemVariants as List<POS.Models.FoodItemVariant>
                   ?? new List<POS.Models.FoodItemVariant>();
}

<div class="mb-4">

    <h2>Add Deal</h2>

    <p class="text-muted">
        Bundle products together into a discounted deal.
    </p>

</div>


<form asp-action="Create" method="post" enctype="multipart/form-data">

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert">
        </div>
    }

    <!-- DEAL INFORMATION -->
    <div class="card shadow-sm border-0 mb-4">
        
        <div class="card-header bg-white">

            <h5 class="mb-0">
                Deal Information
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- DEAL NAME -->
                <div class="col-md-4 mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. Family Combo" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- DEAL PRICE -->
                <div class="col-md-2 mb-3">

                    <label asp-for="DealPrice"
                           class="form-label">
                    </label>

                    <input asp-for="DealPrice"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="0.00" />

                    <span asp-validation-for="DealPrice"
                          class="text-danger">
                    </span>

                </div>


                <!-- START DATE -->
                <div class="col-md-2 mb-3">

                    <label asp-for="StartDate"
                           class="form-label">
                    </label>

                    <input asp-for="StartDate"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="StartDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- END DATE -->
                <div class="col-md-2 mb-3">

                    <label asp-for="EndDate"
                           class="form-label">
                    </label>

                    <input asp-for="EndDate"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="EndDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- ACTIVE -->
                <div class="col-md-2 mb-3">

                    <label class="form-label d-block">
                        Status
                    </label>

                    <div class="form-check form-switch mt-2">

                       

                        <input asp-for="IsActive"
                               class="form-check-input"
                               type="checkbox"
                               value="true" />
                        <input type="hidden"
                               name="IsActive"
                               value="false" />

                        <label class="form-check-label">
                            Active
                        </label>

                    </div>

                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ImageFile" class="form-label"></label>

                    <input asp-for="ImageFile"
                           class="form-control"
                           type="file"
                           accept="image/*" />

                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <!-- DESCRIPTION -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="2"
                              placeholder="Short description shown to customers">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>



    <!-- DEAL ITEMS -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">

            <div>

                <h5 class="mb-0">
                    Deal Items
                </h5>

                <small class="text-muted">
                    Choose which products (and how many) are included in this deal.
                </small>

            </div>

            <button type="button"
                    class="btn btn-primary btn-sm"
                    id="addItemBtn">

                <i class="bi bi-plus-circle"></i>
                Add Item

            </button>

        </div>


        <div class="card-body">

            <div id="itemsContainer">

                @if (Model.Items != null && Model.Items.Any())
                {
                    for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <div class="item-row border rounded p-3 mb-3">

                            <div class="row align-items-end">

                                <!-- PRODUCT / VARIANT -->
                                <div class="col-md-7 mb-3 mb-md-0">

                                    <label class="form-label">
                                        Product
                                    </label>

                                    <select name="Items[@i].FoodItemVariantId"
                                            class="form-select">

                                        <option value="">
                                            -- Select a product --
                                        </option>

                                         
                                        @foreach (var v in variants)
                                        {
                                            <option value="@v.Id"
                                                    selected="@(Model.Items[i].FoodItemVariantId == v.Id ? "selected" : null)">
                                                @v.FoodItem?.Name @(!string.IsNullOrWhiteSpace(v.VariantName) ? $"- {v.VariantName}" : "")
                                            </option>
                                        }

                                    </select>

                                </div>


                                <!-- QUANTITY -->
                                <div class="col-md-3 mb-3 mb-md-0">

                                    <label class="form-label">
                                        Quantity
                                    </label>

                                    <input name="Items[@i].Quantity"
                                           value="@Model.Items[i].Quantity"
                                           class="form-control"
                                           type="number"
                                           min="1"
                                           step="1" />

                                </div>


                                <!-- REMOVE -->
                                <div class="col-md-2 text-end">

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm remove-item"
                                            title="Remove item">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>

                            </div>

                        </div>
                    }
                }

            </div>


            <!-- NO ITEMS MESSAGE -->
            <div id="noItemsMessage"
                 class="text-center text-muted py-4">

                <i class="bi bi-bag-x fs-2 d-block mb-2"></i>

                No items added.

                <div>
                    Click <strong>Add Item</strong> to add one.
                </div>

            </div>

        </div>

    </div>



    <!-- BUTTONS -->
    <div class="mb-4">

        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-check-circle"></i>
            Save Deal

        </button>


        <a asp-action="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </div>

</form>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            let itemIndex = @((Model.Items?.Count ?? 0));

            const variantOptions = @Html.Raw(
                Json.Serialize(variants.Select(v => new
                {
                    id = v.Id,
                    label = (v.FoodItem != null ? v.FoodItem.Name : "") +
                            (!string.IsNullOrWhiteSpace(v.VariantName) ? " - " + v.VariantName : "")
                }))
            );

            const addItemBtn = document.getElementById("addItemBtn");
            const itemsContainer = document.getElementById("itemsContainer");
            const noItemsMessage = document.getElementById("noItemsMessage");

            // --------------------------------------------------
            // UPDATE "NO ITEMS" MESSAGE
            // --------------------------------------------------
            function updateNoItemsMessage() {
                if (!noItemsMessage) return;

                const rows = itemsContainer.querySelectorAll(".item-row");

                noItemsMessage.style.display = rows.length === 0 ? "block" : "none";
            }


            // --------------------------------------------------
            // BUILD OPTIONS HTML FOR A NEW ROW
            // --------------------------------------------------
            function buildOptionsHtml() {
                let html = `<option value="">-- Select a product --</option>`;

                variantOptions.forEach(function (v) {
                    html += `<option value="${v.id}">${v.label}</option>`;
                });

                return html;
            }


            // --------------------------------------------------
            // ADD NEW ITEM
            // --------------------------------------------------
            if (addItemBtn) {

                addItemBtn.addEventListener("click", function (e) {

                    e.preventDefault();

                    const html = `
                        <div class="item-row border rounded p-3 mb-3">

                            <div class="row align-items-end">

                                <div class="col-md-7">
                                    <label class="form-label">
                                        Product
                                    </label>

                                    <select name="Items[${itemIndex}].FoodItemVariantId"
                                            class="form-select">
                                        ${buildOptionsHtml()}
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">
                                        Quantity
                                    </label>

                                    <input type="number"
                                           name="Items[${itemIndex}].Quantity"
                                           class="form-control"
                                           value="1"
                                           min="1"
                                           step="1" />
                                </div>

                                <div class="col-md-2 text-end">
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm remove-item"
                                            title="Remove item">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                            </div>

                        </div>
                    `;

                    itemsContainer.insertAdjacentHTML("beforeend", html);

                    itemIndex++;

                    updateNoItemsMessage();
                });
            }


            // --------------------------------------------------
            // REMOVE ITEM
            // --------------------------------------------------
            document.addEventListener("click", function (e) {

                const removeButton = e.target.closest(".remove-item");

                if (!removeButton) {
                    return;
                }

                e.preventDefault();

                const row = removeButton.closest(".item-row");

                if (row) {
                    row.remove();
                }

                updateNoItemsMessage();
            });


            // --------------------------------------------------
            // INITIAL STATE
            // --------------------------------------------------
            updateNoItemsMessage();

        });
    </script>

}